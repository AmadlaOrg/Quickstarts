[Unit]
Description=My Application Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/local/bin/myapp serve
Restart=always
RestartSec=5

Environment=NODE_ENV=production

Environment=PORT=3000

Environment=LOG_LEVEL=info


[Install]
WantedBy=multi-user.target
